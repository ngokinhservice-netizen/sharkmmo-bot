# =================================================================
# SHARKMMO — CẤU HÌNH BIẾN MÔI TRƯỜNG HỆ THỐNG
# =================================================================

# 1. Telegram Bot Credentials
# Lấy token từ @BotFather trên Telegram
BOT_TOKEN=7891234567:AAF_your_telegram_bot_token_here

# Danh sách ID Telegram của quản trị viên (phân cách bằng dấu phẩy)
ADMIN_IDS=1336962312,987654321

# 2. Canboso API (Nguồn hàng MMO)
# Buyer API Key cấp từ Canboso (Định dạng x-buyer-key: tgb_...)
CANBOSO_API_KEY=tgb_1234567890abcdef1234567890abcdef1234567890abcdef
CANBOSO_BASE_URL=https://canboso.com
CANBOSO_TIMEOUT_SECONDS=30.0
CANBOSO_CACHE_TTL_SECONDS=60
SOURCE_BALANCE_ALERT_THRESHOLD=100000.0

# 3. Database
# Mặc định sử dụng SQLite async
DATABASE_URL=sqlite+aiosqlite:///./sharkmmo.db
# Hoặc PostgreSQL khi mở rộng VPS:
# DATABASE_URL=postgresql+asyncpg://shark_user:password@localhost:5432/sharkmmo_db

# 4. Bảo mật REST API & Admin Dashboard
ADMIN_API_KEY=sharkmmo_admin_secret_key_2026
JWT_SECRET=sharkmmo_super_jwt_secret_key_9988776655

# 5. Thanh toán Ngân hàng & VietQR
BANK_CODE=MB
BANK_ACCOUNT_NO=0988888888
BANK_ACCOUNT_NAME=NGUYEN VAN A
VIETQR_TEMPLATE=compact2

# 6. Webhook Thanh toán tự động (SePay)
# Đăng ký tài khoản tại sepay.vn để nhận biến động số dư tự động
SEPAY_API_KEY=your_sepay_api_token_here

# 7. Cấu hình Kê giá tự động mặc định
DEFAULT_MARKUP_TYPE=percent
DEFAULT_MARKUP_VALUE=20.0
DEFAULT_ROUND_TO=1000
AUTO_SYNC_INTERVAL_MINUTES=15
